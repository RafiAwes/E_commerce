# Repository-wide ignores.
# Patterns without a leading slash match at any depth, so they cover
# frontend/ and any sibling package added later.

# ----- Dependencies -----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Build output -----
.next/
out/
build/
dist/

# ----- Environment -----
# Real secrets stay local; the checked-in example documents the shape.
.env
.env.*
!.env.example

# ----- Logs and debug output -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- Testing -----
coverage/
.nyc_output/

# ----- Caches -----
.turbo/
.cache/
.eslintcache
.vercel

# ----- TypeScript -----
*.tsbuildinfo
# Regenerated by `next dev` / `next build`.
next-env.d.ts

# ----- Editors and OS -----
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.swp
.idea/
.vscode/

# ----- Claude Code -----
# .claude/launch.json is shared config and stays tracked; per-machine
# settings do not.
.claude/settings.local.json
.claude/*.local.json
