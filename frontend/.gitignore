# Ignores for the Next.js storefront.
#
# This file is self-contained: the frontend can be extracted into its own
# repository and still ignore the right things. The repo root has a matching
# .gitignore for the workspace as a whole.
#
# A leading slash anchors the pattern to this directory; patterns without one
# match at any depth beneath it.

# ----- Dependencies -----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Next.js build output -----
/.next/
/out/
/build
/dist

# ----- Environment -----
# Real values stay local. The checked-in example documents the variables
# without carrying any secrets, so it is re-included below.
.env
.env.*
!.env.example

# ----- Logs and debug output -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- Testing -----
/coverage
/.nyc_output

# ----- Caches -----
/.turbo
/.cache
.eslintcache
.vercel

# ----- TypeScript -----
*.tsbuildinfo
# Regenerated by `next dev` and `next build`.
next-env.d.ts

# ----- Generated assets -----
# Placeholder artwork IS committed so the prototype renders on a fresh clone
# (`npm run placeholders` regenerates it). Uncomment if real photography
# replaces it and you would rather build the assets in CI.
# /public/images

# ----- Editors and OS -----
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.swp
.idea/
.vscode/
